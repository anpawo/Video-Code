*.gif

# Python
__pycache__/
*.pyc

# Direnv
.envrc
.direnv/

# Python virtual environments, whatever they were named
*venv/

# Build trees, and what vcpkg installs from the manifest. The manifest itself,
# the overlay ports and triplets, and the chainload toolchain stay tracked.
build*/
vcpkg_installed/

# The binary `make` copies to the root
/video-code

# Mac
.DS_Store

# VS Code
.vscode/

# Claude
CLAUDE.md
.claude/

# Misc
wherewasi
todo
pgn

# Visual regression golden images — tracked despite the *.png rule above,
# the test suite needs them to compare against on a fresh checkout.
!test/visual/golden/*.png

# The asset a scene of the corpus reads. Ignored, it made image_shape.py
# impossible to bake from a clean clone — the repo asked its own test suite for
# a file it did not contain.
!wb.png

