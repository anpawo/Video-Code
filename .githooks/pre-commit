#!/usr/bin/env bash
# Armed with  git config core.hooksPath .githooks  (this repo does it in its
# Makefile's `arm` target). Bypass once with  git commit --no-verify.
#
# Deliberately fast — under 15 s — because a hook that costs a minute is a hook
# everyone learns to bypass. The slow gates do NOT live here: the render and
# performance gates need a real GPU and a local baseline, so they are
# `make check`, run when you want them, never on your critical path. Everything
# else runs on GitHub (.github/workflows/ci.yaml).

set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

# Every other gate here reads what the change ADDS. None reads what it FORGETS,
# and a commit that deletes two workflows while their replacements sit untracked
# passes all three of them.
printf "→ the repository contains what it calls\n"
python3 test/tracked_check.py || {
    printf "\n\033[31m✗ commit cancelled — a build driver names a file that is not in git\033[0m\n"
    exit 1
}

printf "\n→ coverage of new public API\n"
python3 test/coverage_check.py || {
    printf "\n\033[31m✗ commit cancelled — new public API is missing docs or tests\033[0m\n"
    exit 1
}

# 4 live errors sat in the tree while this ran nowhere: the CI step that was
# supposed to catch them was skipped by GitHub whenever the step before it
# failed, which was every run for eight weeks.
printf "\n→ types\n"
python3 -m pyright || {
    printf "\n\033[31m✗ commit cancelled — pyright\033[0m\n"
    exit 1
}

# 1.5 s, and it opens NO window: the QML is instantiated against a hidden
# window, so every parse error and every binding that fails to resolve is
# caught without anything appearing on screen. qmllint cannot see those.
printf "\n→ formatting\n"
if ! command -v clang-format > /dev/null 2>&1; then
    printf "\033[33m  skipped — no clang-format here; the CI lane will check it.\033[0m\n"
else
    # The one gate that lived only in CI, which is how a formatting violation
    # got pushed: the hook said clean, the lane said no, and the round trip was
    # a push and three minutes. Same list the workflow uses.
    # `-name` twice, not `-regex '.*\.\(cpp\|hpp\)'`. That regex is GNU
    # syntax; BSD find matches NOTHING with it, so `$files` came out empty, the
    # `[ -n ]` guard short-circuited, and this check printed success having
    # looked at zero files — the exact failure it was added to prevent, inside
    # the fix for it. Counted now, and an empty list is an error.
    # `.claude/worktrees/` too: an agent working in its own worktree lives
    # INSIDE this directory, build tree and all, and CMake writes a probe file
    # there that no formatter will ever like. The hook was reading another
    # checkout's generated C++ and refusing a commit that touched one doc.
    files=$(find . \( -name '*.cpp' -o -name '*.hpp' \) \
        -not -path './build/*' -not -path './build-qml/*' -not -path './vcpkg_installed/*' \
        -not -path './.claude/worktrees/*')
    count=$(printf '%s\n' "$files" | grep -c . || true)
    if [ "$count" -lt 50 ]; then
        printf "\n\033[31m✗ commit cancelled — the formatting check found %s files, which cannot be right\033[0m\n" "$count"
        exit 1
    fi
    if ! clang-format -n -Werror $files 2> /tmp/vc_fmt.txt; then
        head -20 /tmp/vc_fmt.txt
        printf "\n\033[31m✗ commit cancelled — run \`clang-format -i\` on the files above\033[0m\n"
        exit 1
    fi
    printf "  %s .cpp/.hpp files, all formatted\n" "$count"
fi

printf "\n→ the chrome still loads\n"
if [ ! -x ./video-code ]; then
    # Said out loud rather than skipped. This block used to be wrapped in the
    # test, so on a checkout that has not been built the whole thing vanished —
    # heading included — and the hook printed "clean" having never looked at the
    # QML. That is the one case where nobody had checked it yet.
    printf "\033[33m  skipped — ./video-code is not built. Run \`make\` and commit again to have the QML checked.\033[0m\n"
else
    ./video-code --check-chrome || {
        printf "\n\033[31m✗ commit cancelled — QML\033[0m\n"
        exit 1
    }
fi

printf "\n\342\206\222 repetition and unreachable surface\n"
python3 test/repetition_check.py || {
    # No backticks in a double-quoted string: they would RUN the command
    # rather than name it, which is how a help message becomes a second
    # execution of the thing that just failed.
    printf "\n\033[31m\342\234\227 commit cancelled \342\200\224 this adds repetition or dead surface.\033[0m\n"
    printf "  python3 test/repetition_check.py --list  says where.\n"
    exit 1
}

# The bake digest — what the scenes ASK the renderer to do, hashed. It lived
# only in CI, and that cost a round trip today: giving the rotation shader an
# `about` field put an `about: null` on every rotation entry in the corpus, nine
# scenes drifted, and the visual suite stayed green the whole time because not
# one pixel moved. 1s here against three minutes of CI to learn the same thing.
printf "\n→ the work the scenes ask for\n"
python3 test/perf/digest.py || {
    printf "\n\033[31m✗ commit cancelled — the bake digest moved. If that is what the change meant: python3 test/perf/digest.py --update\033[0m\n"
    exit 1
}

printf "\033[32m✓ pre-commit clean\033[0m\n"
