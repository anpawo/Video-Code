{
  "name": "video-code",
  "version-string": "1.0.0",
  "dependencies": [
    "opencv4",
    {
      "name": "qtbase",
      "default-features": false,
      "features": ["gui", "widgets", "opengl", "vulkan"]
    },
    {
      "name": "qtbase",
      "features": ["xcb"],
      "platform": "linux"
    },
    "qtdeclarative",
    "nlohmann-json",
    "argparse",
    "ffmpeg",
    "protobuf",
    "curl",
    "glslang",
    "vulkan",
    {
      "name": "vulkan-loader",
      "features": ["xcb"],
      "platform": "linux"
    },
    "freetype",
    "earcut-hpp"
  ]
}
